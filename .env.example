# Copie para .env no servidor (EasyPanel) e preencha. NUNCA commite valores reais.

# --- Evolution API ---
EVOLUTION_API_URL=
EVOLUTION_INSTANCE=ap
EVOLUTION_API_KEY=

# --- Chatwoot ---
CHATWOOT_URL=
CHATWOOT_ACCOUNT_ID=1
CHATWOOT_API_TOKEN=

# --- Sistema Nilo (login do vendedor) ---
NILO_URL=https://nilo.autopratense.com.br
NILO_CNPJ=
NILO_LOGIN=
NILO_SENHA=
# Sessões simultâneas no site
NILO_MAX_SESSOES=5

# --- Modelo de IA ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# --- Banco da base de conhecimento (Postgres com pgvector) ---
DATABASE_URL=

# --- Escalonamento ---
# Número do gestor, só dígitos com DDI (ex.: 5547...)
GESTOR_WHATSAPP=

# --- Segurança do webhook ---
# Segredo compartilhado, enviado pela Evolution no cabeçalho do webhook
WEBHOOK_SECRET=

# --- Regras de pedido (confirmar com a empresa) ---
PEDIDO_FILIAL_PADRAO=
PEDIDO_CONDICAO_PAGAMENTO_PADRAO=
PEDIDO_TRANSPORTADORA_PADRAO=
