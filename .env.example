# Copie para .env no servidor (EasyPanel) e preencha. NUNCA commite valores reais.

# --- Evolution API ---
EVOLUTION_API_URL=
EVOLUTION_INSTANCE=ap
EVOLUTION_API_KEY=

# --- Chatwoot ---
CHATWOOT_URL=
CHATWOOT_ACCOUNT_ID=1
CHATWOOT_API_TOKEN=

# --- Sistema Nilo (login do vendedor) ---
NILO_URL=https://nilo.autopratense.com.br
NILO_CNPJ=
NILO_LOGIN=
NILO_SENHA=
# Sessões simultâneas no site
NILO_MAX_SESSOES=5

# --- Modelo de IA ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# --- Banco da base de conhecimento (Postgres com pgvector) ---
DATABASE_URL=

# --- Escalonamento ---
# Número do gestor, só dígitos com DDI (ex.: 5547...)
GESTOR_WHATSAPP=

# --- Segurança do webhook ---
# Segredo compartilhado, enviado pela Evolution no cabeçalho do webhook
WEBHOOK_SECRET=

# --- Regras de pedido ---
# MODO DE TESTE: true = para antes de clicar em "Enviar Pedido". Deixe true até a empresa autorizar.
PEDIDO_DRY_RUN=true
# Números que podem falar com o robô durante os testes (DDI+DDD+número, separados por vírgula).
# Em modo de teste, sem esta lista, o robô não responde a ninguém.
TESTE_NUMEROS_PERMITIDOS=
# Ordem de preferência das filiais (Joinville primeiro)
PEDIDO_FILIAIS_ORDEM=JOI,ITJ,CH,SJ,CRI
# Nome da opção de retirada na lista de transportadoras
PEDIDO_TRANSPORTADORA_RETIRA=RETIRA-JOI
